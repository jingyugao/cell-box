[Unit]
Description=Node-local recoverable Pod controller
After=k3s.service
Requires=k3s.service

[Service]
Type=simple
Environment=KUBECONFIG=/etc/resumablepod/kubeconfig
EnvironmentFile=/etc/resumablepod/controller.env
ExecStart=/usr/local/libexec/resumablepod-controller --node=${NODE_NAME} --namespace=recoverable-system
Restart=on-failure
RestartSec=3
TimeoutStopSec=60
UMask=0077
# Host runsc and its gofer need the node's namespaces and runtime directories.
# Do not add PrivateMounts/PrivateTmp without validating gVisor FD/path behavior.

[Install]
WantedBy=multi-user.target
